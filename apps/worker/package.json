{
  "name": "worker",
  "version": "1.0.0",
  "description": "Sloth background job worker",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsup --watch --onSuccess \"node dist/index.js\"",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/ai": "workspace:^",
    "@repo/db": "workspace:^",
    "@repo/env": "workspace:^",
    "bullmq": "^6.7.6",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "cross-env": "^10.1.0",
    "tsup": "^9.0.0",
    "typescript": "7.0.2"
  }
}
