enum EmailStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Email {
  id             String      @id @default(cuid())
  gmailMessageId String
  threadId       String?
  sender         String
  recipients     String[]    @default([])
  subject        String
  body           String      @db.Text
  html           String?     @db.Text
  snippet        String?
  labels         String[]    @default([])
  status         EmailStatus @default(PENDING)
  receivedAt     DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  userId         String
  gmailAccountId String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount   GmailAccount   @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  emailAnalysis  EmailAnalysis?

  @@unique([gmailAccountId, gmailMessageId])
  @@index([userId, receivedAt])
  @@index([gmailAccountId, receivedAt])
  @@index([gmailAccountId, threadId])
  @@map("email")
}

model EmailAnalysis {
  id            String   @id @default(cuid())
  category      String
  priority      String
  requiresReply Boolean
  intent        String
  summary       String   @db.Text
  actionItems   String[]
  deadlines     String[]
  suggestedTone String
  replyDraft    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailId String @unique
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@map("email_analysis")
}
