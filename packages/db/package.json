{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "generate": "prisma generate --config prisma7.config.ts",
    "format": "prisma format --config prisma7.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@repo/env": "workspace:*",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "eslint": "10.9.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
